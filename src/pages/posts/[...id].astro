---
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, isoDate, sortPosts } from '../../utils';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, prev: posts[index + 1], next: posts[index - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<Base wide title={post.data.title} description={post.data.description} article>
  <div class="page-column">
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="lede">{post.data.description}</p>}
      <div class="meta">
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        <span class="post-views" data-views-slug={post.id} hidden></span>
        {post.data.updated && (
          <span>· 更新于 {formatDate(post.data.updated)}</span>
        )}
        {
          post.data.tags.length > 0 && (
            <ul class="tag-list" style="margin-block-start: 0.5rem">
              {post.data.tags.map((tag) => (
                <li>
                  <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="post-nav" aria-label="相邻文章">
      <div>{prev ? <a href={`/posts/${prev.id}/`}>← {prev.data.title}</a> : <span class="muted">没有更早的了</span>}</div>
      <div>{next ? <a href={`/posts/${next.id}/`}>{next.data.title} →</a> : <span class="muted">已经是最新一篇</span>}</div>
    </nav>

    <Comments slug={post.id} />
  </article>
  </div>
</Base>

<script>
  {
    const label = document.querySelector<HTMLElement>('[data-views-slug]');
    const slug = label?.dataset.viewsSlug;

    const show = (views?: number) => {
      if (label && views) {
        label.textContent = `· ${views} 次阅读`;
        label.hidden = false;
      }
    };

    if (label && slug) {
      // 访客 ID：同一浏览器 24 小时内只算一次阅读，换设备/清缓存才会重新计
      let visitor = '';
      try {
        visitor = localStorage.getItem('dsh.vid') ?? '';
        if (!visitor) {
          visitor =
            typeof crypto.randomUUID === 'function'
              ? crypto.randomUUID().replace(/-/g, '')
              : Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2);
          localStorage.setItem('dsh.vid', visitor);
        }
      } catch {
        visitor = '';
      }

      const seenKey = `dsh.viewed.${slug}`;
      let counted = false;
      try {
        const last = Number(localStorage.getItem(seenKey) ?? '0');
        counted = Date.now() - last < 86400000;
      } catch {
        counted = false;
      }

      if (counted) {
        fetch(`/api/views?slugs=${encodeURIComponent(slug)}`)
          .then((response) => (response.ok ? response.json() : null))
          .then((data: { views?: Record<string, number> } | null) => show(data?.views?.[slug]))
          .catch(() => {});
      } else {
        fetch('/api/views', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug, visitor }),
        })
          .then((response) => (response.ok ? response.json() : null))
          .then((data: { views?: number } | null) => {
            show(data?.views);
            try {
              localStorage.setItem(seenKey, String(Date.now()));
            } catch {
              // 忽略隐私模式下的写入失败
            }
          })
          .catch(() => {
            // 统计失败不影响阅读
          });
      }
    }
  }
</script>
