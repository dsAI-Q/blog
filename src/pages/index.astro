---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SidePanel from '../components/SidePanel.astro';
import { SITE } from '../consts';
import { GROUPS, INTRO } from '../data/links';
import { AD } from '../data/ads';
import { PROMPTS } from '../data/prompts';
import { getCollection } from 'astro:content';
import { sortPosts } from '../utils';

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const latest = posts.slice(0, 8);

const promptCount = PROMPTS.length;
const imagePrompts = PROMPTS.filter((prompt) => prompt.category === '图像').length;
const videoPrompts = PROMPTS.filter((prompt) => prompt.category === '视频').length;
---

<Base wide>
  <figure class="banner">
    <img
      src={SITE.banner.src}
      width={SITE.banner.width}
      height={SITE.banner.height}
      alt={SITE.banner.alt}
      fetchpriority="high"
      decoding="async"
    />

    <div class="banner-caption">
      <p class="banner-note">
        微信 <span class="copyable">{INTRO.contact.wechat}</span> &amp; QQ <span
          class="copyable">{INTRO.contact.qq}</span
        >
      </p>
      <nav class="banner-links" aria-label="快捷入口">
        <a href="/vip/">Ai一对一陪练</a>
        <a href="/archive/">全部文章</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </div>
  </figure>

  <div class="home-grid">
    <div class="col col-left">
      <SidePanel
        title={GROUPS.study.title}
        note={GROUPS.study.note}
        items={GROUPS.study.items}
      />
      <SidePanel
        title={GROUPS.platforms.title}
        note={GROUPS.platforms.note}
        items={GROUPS.platforms.items}
      />
      <SidePanel
        title={GROUPS.drives.title}
        note={GROUPS.drives.note}
        items={GROUPS.drives.items}
      />
    </div>

    <section class="col col-main panel">
      <h2 class="panel-head">
        最新文章
        <span class="panel-note">{posts.length} 篇</span>
      </h2>

      {
        latest.length === 0 ? (
          <p class="muted" style="padding: 1rem 1.1rem 1.5rem">
            还没有文章。用<a href="/edit/">编辑器</a>写第一篇吧。
          </p>
        ) : (
          <ul class="post-list post-list-inset">
            {latest.map((post) => (
              <li>
                <PostCard post={post} />
              </li>
            ))}
          </ul>
        )
      }

      {
        posts.length > latest.length && (
          <p class="panel-foot">
            <a href="/archive/">全部 {posts.length} 篇文章 →</a>
          </p>
        )
      }
    </section>

    <aside class="col col-right">
      <section class="ad-card">
        <p class="ad-badge">{AD.badge}</p>
        <h2>{AD.title}</h2>
        <p class="ad-sub">{AD.subtitle}</p>
        <ul class="ad-points">
          {AD.points.map((point) => <li>{point}</li>)}
        </ul>
        <a class="btn ad-cta" href={AD.href}>{AD.ctaLabel}</a>
        {AD.note && <p class="ad-note">{AD.note}</p>}
      </section>
    </aside>
  </div>

  <section class="promo">
    <div class="promo-text">
      <h2>ComfyUI 提示词库</h2>
      <p>
        共 {promptCount} 条提示词生成器：图像 {imagePrompts} 条、视频 {videoPrompts} 条，
        覆盖 MiniMax H3、LTX 2、Wan 2.2、Viggle 等。点开看全文，一键复制。
      </p>
    </div>
    <a class="btn" href="/prompts/">进入提示词库 →</a>
  </section>
</Base>
