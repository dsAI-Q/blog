---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ResourceGroups from '../components/ResourceGroups.astro';
import { SITE } from '../consts';
import { INTRO, RESOURCE_GROUPS } from '../data/links';
import { getCollection } from 'astro:content';
import { sortByDateDesc } from '../utils';

const posts = sortByDateDesc(await getCollection('posts', ({ data }) => !data.draft));
const latest = posts.slice(0, 5);
---

<Base>
  <figure class="banner">
    <img
      src={SITE.banner.src}
      width={SITE.banner.width}
      height={SITE.banner.height}
      alt={SITE.banner.alt}
      fetchpriority="high"
      decoding="async"
    />
  </figure>

  <section class="welcome">
    <h1>
      {INTRO.headline}
      <span class="subhead">{INTRO.subhead}</span>
    </h1>
    <p class="lede">{INTRO.lead}</p>

    <div class="cta">
      {
        INTRO.primary.map((link) => (
          <a class="btn" href={link.href} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        ))
      }
      <a class="btn ghost" href={INTRO.secondary.href} target="_blank" rel="noopener noreferrer">
        {INTRO.secondary.label} →
      </a>
    </div>
  </section>

  <ResourceGroups groups={RESOURCE_GROUPS} />

  <section class="latest">
    <h2 class="section-title">最新文章</h2>
    {
      latest.length === 0 ? (
        <p class="muted" style="padding-block: 1.5rem">
          还没有文章。把 Markdown 放进 <code>src/content/posts/</code>，或者用<a href="/edit/">编辑器</a>写一篇。
        </p>
      ) : (
        <ul class="post-list">
          {latest.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      )
    }
    {
      posts.length > latest.length && (
        <p class="more">
          <a href="/archive/">全部 {posts.length} 篇文章 →</a>
        </p>
      )
    }
  </section>
</Base>
