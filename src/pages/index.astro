---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SidePanel from '../components/SidePanel.astro';
import { SITE } from '../consts';
import { GROUPS, INTRO } from '../data/links';
import { ADS } from '../data/ads';
import { PROMPTS } from '../data/prompts';
import { getCollection } from 'astro:content';
import { sortPosts } from '../utils';

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const latest = posts.slice(0, 8);

const promptCount = PROMPTS.length;
const imagePrompts = PROMPTS.filter((prompt) => prompt.category === '图像').length;
const videoPrompts = PROMPTS.filter((prompt) => prompt.category === '视频').length;
---

<Base wide dark>
  <link slot="head" rel="stylesheet" href="/dark-home.css" />
  <figure class="banner">
    <img
      src={SITE.banner.src}
      width={SITE.banner.width}
      height={SITE.banner.height}
      alt={SITE.banner.alt}
      fetchpriority="high"
      decoding="async"
    />

    <div class="banner-caption">
      <p class="banner-note">
        微信 <span class="copyable">{INTRO.contact.wechat}</span> &amp; QQ <span
          class="copyable">{INTRO.contact.qq}</span
        >
      </p>
      <nav class="banner-links" aria-label="快捷入口">
        <a href="/vip/">Ai一对一陪练</a>
        <a href="/archive/">全部文章</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </div>
  </figure>

  <div class="home-grid">
    <div class="col col-left">
      <SidePanel
        title={GROUPS.study.title}
        note={GROUPS.study.note}
        tone={GROUPS.study.tone}
        items={GROUPS.study.items}
      />
      <SidePanel
        title={GROUPS.platforms.title}
        note={GROUPS.platforms.note}
        tone={GROUPS.platforms.tone}
        items={GROUPS.platforms.items}
      />
      <SidePanel
        title={GROUPS.drives.title}
        note={GROUPS.drives.note}
        tone={GROUPS.drives.tone}
        items={GROUPS.drives.items}
      />
    </div>

    <div class="col col-main">
      <section class="promo promo-inline">
        <div class="promo-text">
          <h2>ComfyUI 提示词库</h2>
          <p>
            共 {promptCount} 条提示词生成器：图像 {imagePrompts} 条、视频 {videoPrompts} 条，
            覆盖 MiniMax H3、LTX 2、Wan 2.2、Viggle 等。点开看全文，一键复制。
          </p>
        </div>
        <a class="btn" href="/prompts/">进入提示词库 →</a>
      </section>

      <section class="panel">
      <h2 class="panel-head">
        最新文章
        <span class="panel-note">{posts.length} 篇</span>
      </h2>

      {
        latest.length === 0 ? (
          <p class="muted" style="padding: 1rem 1.1rem 1.5rem">
            还没有文章。用<a href="/edit/">编辑器</a>写第一篇吧。
          </p>
        ) : (
          <ul class="post-list post-list-inset">
            {latest.map((post) => (
              <li>
                <PostCard post={post} />
              </li>
            ))}
          </ul>
        )
      }

      {
        posts.length > latest.length && (
          <p class="panel-foot">
            <a href="/archive/">全部 {posts.length} 篇文章 →</a>
          </p>
        )
      }
    </section>
    </div>

    <aside class="col col-right">
      {
        ADS.map((ad) => (
          <section class:list={['ad-card', ad.quiet && 'ad-card-quiet']}>
            <p class="ad-badge">{ad.badge}</p>
            <h2>{ad.title}</h2>
            <p class="ad-sub">{ad.subtitle}</p>
            <ul class="ad-points">
              {ad.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <a class="btn ad-cta" href={ad.href}>
              {ad.ctaLabel}
            </a>
            {ad.note && <p class="ad-note">{ad.note}</p>}
          </section>
        ))
      }
    </aside>
  </div>

  <button type="button" class="page-fluid-toggle" data-fluid-toggle aria-pressed="true" hidden>
    关闭背景动效
  </button>
</Base>

<script>
  {
    // 首页整页背景流体：用 Pavel Dobryakov 的成熟实现（MIT，webgl-fluid）
    const KEY = 'dsh.fluid';
    const toggle = document.querySelector<HTMLButtonElement>('[data-fluid-toggle]');

    if (toggle) {
      const wide = window.matchMedia('(min-width: 62rem)');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const hasWebgl2 = (() => {
        try {
          return Boolean(document.createElement('canvas').getContext('webgl2'));
        } catch {
          return false;
        }
      })();

      let userOn = true;
      try {
        userOn = localStorage.getItem(KEY) !== 'off';
      } catch {
        userOn = true;
      }

      let canvas: HTMLCanvasElement | null = null;
      let loading = false;
      let started = false;

      const supported = () => hasWebgl2 && wide.matches;
      const shouldRun = () => userOn && supported() && !reduce.matches && !document.hidden;

      const syncLabel = () => {
        toggle.textContent = userOn ? '关闭背景动效' : '开启背景动效';
        toggle.setAttribute('aria-pressed', String(userOn));
        toggle.hidden = !supported();
      };

      const forward = (event: MouseEvent) => {
        canvas?.dispatchEvent(
          new MouseEvent(event.type === 'pointermove' ? 'mousemove' : event.type === 'pointerdown' ? 'mousedown' : event.type, {
            clientX: event.clientX,
            clientY: event.clientY,
            bubbles: true,
          }),
        );
      };

      const onPointerMove = (event: PointerEvent) => {
        lastRealMove = performance.now();
        if (!canvas) return;
        canvas.dispatchEvent(
          new MouseEvent('mousemove', { clientX: event.clientX, clientY: event.clientY, bubbles: true }),
        );
      };
      const onPointerDown = (event: PointerEvent) => {
        lastRealMove = performance.now();
        if (!canvas) return;
        canvas.dispatchEvent(
          new MouseEvent('mousedown', { clientX: event.clientX, clientY: event.clientY, bubbles: true }),
        );
      };

      // 没有鼠标或鼠标不动时：虚拟指针在底部缓慢来回移动，让烟连续飘出，而不是定时一喷一喷
      let lastRealMove = performance.now();
      let lastDrift = 0;
      let driftTime = 0;
      let driftRaf = 0;

      const drift = () => {
        driftRaf = requestAnimationFrame(drift);
        if (!canvas || document.hidden) return;
        const now = performance.now();
        if (now - lastRealMove < 1800) return; // 真的在动鼠标时不插手
        if (now - lastDrift < 100) return;
        lastDrift = now;
        driftTime += 0.1;

        const x = 0.5 + 0.42 * Math.sin(driftTime * 0.9);
        const y = 0.95 + 0.01 * Math.sin(driftTime * 0.6);
        canvas.dispatchEvent(
          new MouseEvent('mousemove', {
            clientX: x * window.innerWidth,
            clientY: y * window.innerHeight,
            bubbles: true,
          }),
        );
      };

      const ensure = async () => {
        if (started || loading || !userOn) return;
        loading = true;
        try {
          const module = await import('../scripts/webgl-fluid.mjs');
          if (!userOn) return;
          canvas = document.createElement('canvas');
          canvas.className = 'page-fluid-canvas';
          canvas.setAttribute('aria-hidden', 'true');
          document.body.append(canvas);

          module.default(canvas, {
            IMMEDIATE: false,
            AUTO: false,
            SIM_RESOLUTION: 128,
            DYE_RESOLUTION: 1024,
            DENSITY_DISSIPATION: 0.8,
            VELOCITY_DISSIPATION: 0.25,
            PRESSURE: 0.8,
            PRESSURE_ITERATIONS: 20,
            CURL: 30,
            SPLAT_RADIUS: 0.16,
            SPLAT_FORCE: 4200,
            SHADING: true,
            COLORFUL: true,
            COLOR_UPDATE_SPEED: 10,
            TRANSPARENT: true,
            BLOOM: false,
            BACK_COLOR: { r: 0, g: 0, b: 0 },
          });

          window.addEventListener('pointermove', onPointerMove, { passive: true });
          window.addEventListener('pointerdown', onPointerDown, { passive: true });
          driftRaf = requestAnimationFrame(drift);
          started = true;
        } catch {
          teardown();
        } finally {
          loading = false;
        }
      };

      function teardown() {
        if (driftRaf) {
          cancelAnimationFrame(driftRaf);
          driftRaf = 0;
        }
        if (canvas) {
          window.removeEventListener('pointermove', onPointerMove);
          window.removeEventListener('pointerdown', onPointerDown);
          canvas.remove();
          canvas = null;
        }
        started = false;
      }

      const sync = async () => {
        syncLabel();
        if (!supported() || !userOn) {
          teardown();
          return;
        }
        if (shouldRun()) await ensure();
      };

      toggle.addEventListener('click', () => {
        userOn = !userOn;
        try {
          localStorage.setItem(KEY, userOn ? 'on' : 'off');
        } catch {
          // 忽略隐私模式
        }
        if (!userOn) teardown();
        void sync();
      });

      document.addEventListener('visibilitychange', () => void sync());
      wide.addEventListener('change', () => void sync());
      reduce.addEventListener('change', () => void sync());

      syncLabel();
      void sync();
    }
  }
</script>


