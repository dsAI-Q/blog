---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'vip');
if (!entry) throw new Error('缺少 src/content/pages/vip.md');

const { Content } = await render(entry);

const contacts = [
  { label: '微信', value: 'qrock168' },
  { label: 'QQ', value: '1416655191' },
];
---

<Base
  title="Ai一对一陪练"
  description="ComfyUI 一对一实战教学：零基础部署、工作流搭建、问题当场解决。入门级 500 元，终身陪练 2000 元。"
>
  <section class="welcome">
    <h1>
      Ai一对一陪练
      <span class="tag">招生中</span>
    </h1>
    <p class="lede">
      ComfyUI 一对一实战教学，零基础也能上手：部署、插件、环境、工作流，全程手把手，问题当场解决。
    </p>

    <div class="cta">
      <a class="btn" href="#enroll">看套餐与报名方式</a>
      <a class="btn ghost" href="/links/">先看免费教程</a>
    </div>

    <ul class="contact-row">
      {
        contacts.map((item) => (
          <li>
            <span class="contact-label">{item.label}</span>
            <span class="contact-value copyable">{item.value}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <article class="prose prose-wide">
    <Content />
  </article>

  <section id="enroll" class="card enroll">
    <h2>报名流程</h2>
    <ol>
      <li>加微信 <code>qrock168</code> 或 QQ <code>1416655191</code>，说明想报哪个套餐。</li>
      <li>按价格缴费（微信 / 支付宝），只认页面里的收款码。</li>
      <li>大圣老师排期，安排一对一教学。</li>
    </ol>
    <p class="muted">缴费前请读完上面的退款与法律条款，缴费即视为同意。</p>
  </section>
</Base>

<style>
  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
    list-style: none;
    padding: 0;
    margin-block-start: 1.25rem;
    font-size: 0.95rem;
  }

  .contact-row li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .contact-label {
    color: var(--ink-2);
    font-size: 0.8rem;
  }

  .contact-value {
    font-weight: 700;
    user-select: all;
  }

  .prose-wide {
    max-inline-size: 72ch;
    padding-block-end: 1rem;
  }

  .prose-wide :global(h3) {
    margin-block-start: 2.2em;
  }

  .prose-wide :global(table) {
    display: block;
    overflow-x: auto;
  }

  .enroll {
    margin-block: 2rem 4rem;
    max-inline-size: 72ch;
  }

  .enroll h2 {
    font-size: 1.15rem;
  }

  .enroll ol {
    margin-block: 0.75rem;
    padding-inline-start: 1.3em;
  }

  .enroll li + li {
    margin-block-start: 0.4rem;
  }

  .enroll p {
    margin-block-start: 0.75rem;
  }
</style>
