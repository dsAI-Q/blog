---
import Base from '../layouts/Base.astro';
import { GROUPS } from '../data/links';

const contact = GROUPS.study.items.filter((item) => ['公众号 大时代Ai', 'QQ 学习群', 'Telegram 电报', 'B 站 UP 主'].includes(item.label));

const items = [
  { title: 'ComfyUI 出图陪跑', desc: '从装环境到跑出第一张图，卡在哪就解决哪，不背文档。' },
  { title: '工作流排查', desc: '报错、爆显存、节点缺失、出图发灰，带着你的工作流来现场看。' },
  { title: '模型与参数选型', desc: '按你的显卡和需求挑模型、定采样参数，不盲目抄配置。' },
  { title: '选题与内容', desc: '想拍视频或写文章但不知道做什么，一起把方向定下来。' },
];
---

<Base
  title="Ai一对一陪练"
  description="Ai 一对一陪练：ComfyUI 出图、工作流排查、模型选型，按你的实际情况带着跑通。"
>
  <section class="welcome">
    <h1>
      Ai一对一陪练
      <span class="tag">筹备中</span>
    </h1>
    <p class="lede">
      一对一的实战陪练，不是录播课。你带着自己的机器、自己的需求来，我们把问题在这一次聊透。
      目前在做排期和形式上的准备，先占个位置。
    </p>
    <div class="cta">
      <a class="btn" href={GROUPS.study.items[0].href} target="_blank" rel="noopener noreferrer">
        先看视频教程
      </a>
      <a class="btn ghost" href="/links/">全部资源与渠道</a>
    </div>
  </section>

  <h2 class="section-title">能陪你做什么</h2>
  <ul class="card-grid">
    {
      items.map((item) => (
        <li class="card">
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </li>
      ))
    }
  </ul>

  <h2 class="section-title">开通方式</h2>
  <div class="card" style="margin-block: 1.25rem">
    <p>
      还没开放购买。等排期定了会先在这里放出形式和价格，公众号和 QQ 群会第一时间通知。
    </p>
    <ul class="tag-list" style="margin-block-start: 0.75rem">
      {
        contact.map((item) => (
          <li>
            {item.href ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.label}
              </a>
            ) : (
              <span class="tag">{item.label}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</Base>
