---
import Base from '../layouts/Base.astro';
import PromptList from '../components/PromptList.astro';
import { PROMPTS } from '../data/prompts';

const CATEGORIES = ['视频', '图像', '通用'] as const;

const count = (category: (typeof CATEGORIES)[number]) => PROMPTS.filter((prompt) => prompt.category === category).length;
const of = (category: (typeof CATEGORIES)[number]) => PROMPTS.filter((prompt) => prompt.category === category);
const hasAny = (category: (typeof CATEGORIES)[number]) => count(category) > 0;

const video = of('视频');
const image = of('图像');
const universal = of('通用');

const models = [...new Set(PROMPTS.map((prompt) => prompt.model))].map((model) => ({
  model,
  count: PROMPTS.filter((prompt) => prompt.model === model).length,
}));

const workflowCount = PROMPTS.filter((prompt) => prompt.source === 'workflow').length;
---

<Base
  wide
  title="ComfyUI 提示词"
  description={`${PROMPTS.length} 条 ComfyUI 提示词：图像与视频的模型、系统提示词，点开看全文、一键复制。`}
>
  <div class="page-column">
    <section class="welcome">
      <h1>ComfyUI 提示词</h1>
      <p class="lede">
        共 {PROMPTS.length} 条，其中 {workflowCount} 条直接取自实际在用的 ComfyUI 工作流节点。
        点开看全文，一键复制。
      </p>

      <nav class="prompt-filters" aria-label="分类筛选">
        <a href="#all">全部 {PROMPTS.length}</a>
        {CATEGORIES.filter(hasAny).map((category) => (
          <a href={`#${category}`}>
            {category} {count(category)}
          </a>
        ))}
        {
          models.map((item) => (
            <a class="prompt-filter-model" href="#all" data-model={item.model}>
              {item.model} {item.count}
            </a>
          ))
        }
      </nav>
    </section>

    <div id="all">
      <div class="prompt-columns">
        <section id="视频" class="prompt-column">
          <h2 class="prompt-column-title">
            AI 视频提示词库 <span class="prompt-column-count">{video.length} 条</span>
          </h2>
          <PromptList items={video} />
        </section>

        <section id="图像" class="prompt-column">
          <h2 class="prompt-column-title">
            AI 图像提示词库 <span class="prompt-column-count">{image.length} 条</span>
          </h2>
          <PromptList items={image} />
        </section>
      </div>

      {
        universal.length > 0 && (
          <section id="通用" class="prompt-column prompt-column-wide">
            <h2 class="prompt-column-title">
              AI 通用提示词库 <span class="prompt-column-count">{universal.length} 条</span>
            </h2>
            <PromptList items={universal} />
          </section>
        )
      }
    </div>

    <p class="prompt-foot muted">
      正文按需加载（一次载入全部，之后即刻可用）。「工作流」标签表示这条直接来自 ComfyUI 工作流里的节点原文。
    </p>
  </div>
</Base>

<script>
  // 正文懒加载：首次展开任意条目时，抓一次 prompts-data.json 并缓存
  let dataPromise: Promise<Record<string, string>> | null = null;

  function loadData() {
    dataPromise ??= fetch('/prompts-data.json', { cache: 'force-cache' })
      .then((response) => response.json())
      .catch(() => ({}));
    return dataPromise;
  }

  async function fill(details: HTMLDetailsElement) {
    const pre = details.querySelector('pre');
    if (!pre || pre.dataset.loaded === '1') return;

    const data = await loadData();
    const text = data[details.dataset.id ?? ''] ?? '（这条正文没找到，可能已更新）';
    pre.textContent = text;
    pre.dataset.loaded = '1';
  }

  document.addEventListener(
    'toggle',
    (event) => {
      const details = event.target as HTMLDetailsElement;
      if (details instanceof HTMLDetailsElement && details.open) void fill(details);
    },
    true,
  );

  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!button) return;

    const details = button.closest('details');
    if (details instanceof HTMLDetailsElement) await fill(details);

    const pre = button.closest('.prompt-body')?.querySelector('pre');
    const text = pre?.textContent ?? '';
    if (!text || text.startsWith('展开后')) return;

    const original = button.textContent;
    try {
      await navigator.clipboard.writeText(text);
      button.textContent = '已复制 ✓';
    } catch {
      const range = document.createRange();
      if (pre) {
        range.selectNodeContents(pre);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      button.textContent = '已选中，按 Ctrl+C';
    }
    window.setTimeout(() => {
      button.textContent = original;
    }, 1600);
  });
</script>
