---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { sortPosts } from '../../utils';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
  const tags = new Set<string>();
  for (const post of posts) post.data.tags.forEach((t) => tags.add(t));

  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`} description={`标签 #${tag} 下的 ${posts.length} 篇文章。`}>
  <section class="hero">
    <h1>#{tag}</h1>
    <p>{posts.length} 篇文章。</p>
  </section>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))
    }
  </ul>

  <p style="padding-block: 2rem"><a href="/tags/">← 全部标签</a></p>
</Base>
